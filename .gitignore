# Rust build artifacts
target/
target-local/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Session storage (per-workspace)
.huginn/
.huginn/sessions/
.huginn/cargo-home/
.huginn/npm-cache/
.huginn/tmp/
.huginn/state/
.ollama-grok/sessions/
.hermes/

# Scratch directories (throwaway test/eval sandboxes created during dev)
.tmp-*/
# Environment / secrets
.env
.env.local

# Release signing secret key (public key is committed as huginn-signing-key.pub)
*.pem

# Logs
*.log

# apply_patch safety backups
*.bak

# Live eval reports (regenerated by evals/run.py)
evals/out/
evals/__pycache__/
.tmp/
# Per-workspace memory file (agent-managed, like sessions) — the trailing
# slash here only matches a directory, so keep both forms.
.huginn/MEMORY.md
.huginn/MEMORY.md/
